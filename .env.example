GEMINI_API_KEY=replace_with_your_key
DATABASE_URL=postgresql://copilot:development_only@localhost:5432/incidents
GEMINI_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
MIN_SIMILARITY=0.50

# Required for all API routes except /, /health and Swagger docs.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
COPILOT_API_KEY=replace_with_random_32_byte_token
